# Deliberate Debian/general-purpose delta, applied to the pinned upstream config.
CONFIG_CACHY=y
CONFIG_SCHED_BORE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=1
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_MZEN4 is not set
CONFIG_TCP_CONG_BBR3=m
CONFIG_MQ_IOSCHED_ADIOS=m
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
# CONFIG_DEFAULT_SECURITY_SMACK is not set
# CONFIG_DEFAULT_SECURITY_TOMOYO is not set
# CONFIG_DEFAULT_SECURITY_DAC is not set
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
