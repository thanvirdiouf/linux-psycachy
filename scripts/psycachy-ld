#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail

# Probes such as --version must behave exactly like the real versioned linker.
# Kbuild retains ownership of -r, LTO optimisation, visibility and module flags.
output=
expect_output=0
for arg in "$@"; do
    if [[ $expect_output == 1 ]]; then
        output=$arg
        expect_output=0
        continue
    fi
    case "$arg" in
        -o|--output) expect_output=1 ;;
        --output=*) output=${arg#--output=} ;;
        -o?*) output=${arg#-o} ;;
    esac
done
extra=()
if [[ -n $output && $output != /dev/null ]]; then
    if [[ ${PSYCACHY_THINLTO_TUNING:-1} == 1 ]]; then
        case "${output##*/}" in
            vmlinux|vmlinux.o|.tmp_vmlinux*) jobs=${PSYCACHY_KERNEL_LINK_JOBS:-1} ;;
            *) jobs=${PSYCACHY_MODULE_LINK_JOBS:-1} ;;
        esac
        extra+=("--threads=$jobs" "--thinlto-jobs=$jobs")
    fi
    if [[ -n ${PSYCACHY_THINLTO_CACHE:-} ]]; then
        extra+=("--thinlto-cache-dir=$PSYCACHY_THINLTO_CACHE"
            --thinlto-cache-policy=cache_size_bytes=2g:cache_size=0%:prune_interval=1m)
    fi
fi
exec "${PSYCACHY_REAL_LD:?Set PSYCACHY_REAL_LD to the versioned ld.lld}" "$@" "${extra[@]}"
